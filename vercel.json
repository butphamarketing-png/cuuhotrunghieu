{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/adminbp", "destination": "/adminbp/index.html" },
    { "source": "/adminbp/", "destination": "/adminbp/index.html" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/adminbp", "permanent": false },
    { "source": "/admin.html", "destination": "/adminbp", "permanent": false },
    { "source": "/bai-viet", "destination": "/tin-tuc", "permanent": true },
    { "source": "/bai-viet/:path*", "destination": "/tin-tuc/:path*", "permanent": true }
  ]
}
